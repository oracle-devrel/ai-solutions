# The local deployment Dockerfile deliberately embeds deployment-local/.env.
# Keep all other local deployment files out of the build context.
deployment-local/*
!deployment-local/Dockerfile
!deployment-local/.env
!deployment-local/wheels/
!deployment-local/wheels/*.whl
