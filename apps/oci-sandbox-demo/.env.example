# OCI OpenAI-compatible endpoint configuration.
OCI_REGION=us-chicago-1
OCI_COMPARTMENT_ID=ocid1.compartment.oc1..xxxx

# Create an OCI Generative AI Project in the compartment above, then paste its OCID.
# It is used both by the OCI model tutorial and Containers API sandbox calls.
OCI_GENAI_PROJECT_ID=
OCI_SANDBOX_PROJECT_ID=
# Used only for local development, where the user-principal profile is read from
# ~/.oci/config. Container Instances instead use their resource principal.
OCI_CLI_PROFILE=DEFAULT

# Create an OCI Generative AI API key in the same compartment. This is NOT an OpenAI key.
OCI_GENAI_API_KEY=

# Use a model supported by the OCI Responses API in us-chicago-1.
OCI_MODEL_ID=openai.gpt-oss-120b
