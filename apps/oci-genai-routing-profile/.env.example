# Never commit a real OCI Generative AI API key.
OCI_REGION=us-chicago-1
OCI_COMPARTMENT_ID=ocid1.compartment.oc1..replace-me
OCI_GENAI_PROJECT_ID=ocid1.generativeaiproject.oc1.us-chicago-1.replace-me
OCI_GENAI_API_KEY=sk-replace-me
OCI_MODEL_ID=openai.gpt-oss-120b
OCI_CLI_PROFILE=DEFAULT
OCI_CONFIG_FILE=~/.oci/config
# Set after creating the profile. The UI can also accept it interactively.
OCI_ROUTING_PROFILE_ID=ocid1.generativeairoutingprofile.oc1..replace-me
